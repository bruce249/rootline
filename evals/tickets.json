  {
    "id": "T13",
    "lang": "en",
    "messages": [
      {
        "role": "user",
        "content": "Hi, order KC-1020 arrived broken. I want a refund."
      },
      {
        "role": "assistant",
        "content": "I can help with that. What exactly was wrong?"
      },
      {
        "role": "user",
        "content": "The tin was crushed and the tea leaked."
      },
      {
        "role": "assistant",
        "content": "Thanks for explaining. Was anything else damaged?"
      },
      {
        "role": "user",
        "content": "No, just that package."
      },
      {
        "role": "assistant",
        "content": "Understood. Do you want the same items replaced or the money back?"
      },
      {
        "role": "user",
        "content": "I want the money back."
      },
      {
        "role": "assistant",
        "content": "Noted. Is this the only order you are asking about?"
      },
      {
        "role": "user",
        "content": "Yes, only this one."
      },
      {
        "role": "assistant",
        "content": "Thanks. Please confirm you still want a refund."
      },
      {
        "role": "user",
        "content": "Yes I still want a refund."
      },
      {
        "role": "assistant",
        "content": "I will check the policy once I have the order details in front of me."
      },
      {
        "role": "user",
        "content": "Please refund it now. I have already explained the damage."
      }
    ],
    "expected": {
      "refund_paise": null,
      "escalated": false,
      "lang": "en",
      "no_pii": true,
      "max_tool_errors": 0
