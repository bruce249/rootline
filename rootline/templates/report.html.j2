<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rootline {{ run_id }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f3ee; --fg: #1c1915; --muted: #6d655c; --card: #fffdf9; --line: #e4ddd2;
      --accent: #0f6e56; --bad: #b3261e; --good: #1b7f4b; --warn: #8a5a00; --quote: #fff4d6;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #141210; --fg: #f4efe6; --muted: #a59b8e; --card: #221f1b; --line: #3a342c;
              --accent: #8fd0b8; --bad: #ff8a80; --good: #7fd6a4; --warn: #f2c46d; --quote: #3a3020; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--fg); }
    main { max-width: 920px; margin: 0 auto; padding: 32px 16px 64px; }
    h1 { font: 600 30px/1.2 Georgia, serif; margin: 0 0 6px; }
    h2 { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
    section { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-top: 16px; }
    .meta { color: var(--muted); font-size: 14px; }
    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; border: 1px solid currentColor; }
    .COMPLETE { color: var(--good); } .ESCALATED_TO_HUMAN, .FAILED { color: var(--bad); } .HEALTHY { color: var(--accent); }
    .scores { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
    .score { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .score b { display: block; font: 600 30px/1.1 Georgia, serif; }
    .bad { color: var(--bad); } .good { color: var(--good); } .warn { color: var(--warn); }
    blockquote { margin: 8px 0; padding: 12px 14px; background: var(--quote); border-left: 4px solid var(--warn); border-radius: 6px; font: 18px/1.45 Georgia, serif; }
    .chain { display: grid; gap: 8px; }
    .chain div { display: grid; grid-template-columns: 140px 1fr; gap: 10px; font-size: 14px; }
    .chain span:first-child { color: var(--muted); }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
    code, pre { font: 13px/1.45 ui-monospace, "Cascadia Code", monospace; }
    pre { white-space: pre-wrap; word-break: break-word; margin: 0; max-height: 420px; overflow: auto; }
    .add { color: var(--good); } .del { color: var(--bad); }
    a { color: var(--accent); }
    details summary { cursor: pointer; color: var(--muted); }
  </style>
</head>
<body>
<main>
  <p class="meta">Rootline investigation · run <code>{{ run_id }}</code> · branch <code>{{ branch }}</code></p>
  <h1>{{ failure_signature or "No failure found" }}</h1>
  <p><span class="pill {{ status }}">{{ status }}</span>
     <span class="meta">&nbsp;attempt {{ attempt }} · fix mode {{ fix.fix_mode or "n/a" }} · {{ started_at }} → {{ updated_at }}</span></p>

  <section>
    <h2>Result</h2>
    <div class="scores">
      <div class="score"><span class="meta">Before (neatlogs traces)</span><b class="bad">{{ before.passed if before.passed is not none else "?" }}/{{ before.total or "?" }}</b><span class="meta">at {{ (bad_commit or "")[:7] }}</span></div>
      <div class="score"><span class="meta">After (replay)</span><b class="{{ 'good' if verify.passed else 'bad' }}">{{ verify.after_passed if verify.after_passed is not none else "?" }}/{{ verify.after_total or "?" }}</b><span class="meta">at {{ (fix.commit or "")[:7] }}</span></div>
      <div class="score"><span class="meta">Failing tickets fixed</span><b>{{ (verify.target_fixed or [])|length }}/{{ (verify.target_tickets or [])|length }}</b><span class="meta">{{ (verify.target_tickets or [])|join(", ") }}</span></div>
      <div class="score"><span class="meta">Confidence</span><b>{{ confidence }}</b><span class="meta">quote {{ "verified" if quote_verified else "NOT verified" }}</span></div>
    </div>
  </section>

  <section>
    <h2>Wrong assumption</h2>
    <blockquote>{{ assumption_quote }}</blockquote>
    <p>{{ why_wrong }}</p>
    <p><strong>Source of truth</strong> (policy before the change): {{ source_of_truth }}</p>
    {% if policy_tampered %}<p class="warn"><strong>The same session rewrote the policy file to match its change.</strong> Rootline read the policy from before the commit and restored it.</p>{% endif %}
    {% if restore %}<p><strong>Restore:</strong> {{ restore }}</p>{% endif %}
  </section>

  <section>
    <h2>Where it came from (Entire)</h2>
    <div class="chain">
      <div><span>Commit</span><span><code>{{ bad_commit[:12] }}</code>{% if bad_commit_url %} · <a href="{{ bad_commit_url }}">Entire</a>{% endif %}{% if bad_github_url %} · <a href="{{ bad_github_url }}">GitHub</a>{% endif %}</span></div>
      <div><span>Commit range</span><span><code>{{ range or "recent history" }}</code></span></div>
      {% for p in provenance %}
      <div><span>{{ p.file }}:{{ p.line }}</span><span><code>{{ p.content }}</code><br>
        {{ p.authorship or "" }} · {{ p.agent or "unknown agent" }} {{ p.model or "" }} · checkpoint <code>{{ p.checkpoint_id }}</code> · session <code>{{ (p.session_id or "")[:8] }}</code><br>
        <em>prompt:</em> {{ p.prompt }}</span></div>
      {% endfor %}
    </div>
  </section>

  <section>
    <h2>Failing traces (neatlogs)</h2>
    <table>
      <tr><th>Ticket</th><th>Failed checks</th><th>What the agent did</th><th>Trace</th></tr>
      {% for t in failing_traces %}
      <tr><td>{{ t.ticket_id }}</td><td>{{ t.failed_checks|join(", ") }}</td>
        <td>{% for c in t.tool_calls %}<code>{{ c.tool }}</code> {{ c.input }}<br>{% endfor %}</td>
        <td><code>{{ (t.trace_id or "")[:12] }}</code></td></tr>
      {% endfor %}
    </table>
  </section>

  <section>
    <h2>Fix</h2>
    <p>Branch <code>{{ fix.branch }}</code> · commit <code>{{ (fix.commit or "")[:12] }}</code>{% if fix_commit_url %} · <a href="{{ fix_commit_url }}">Entire</a>{% endif %} · pushed {{ fix.pushed }}</p>
    {% if fix.restored_source_of_truth %}<p>Policy file restored to its pre-regression text.</p>{% endif %}
    <pre>{% for line in diff.splitlines() %}<span class="{{ 'add' if line.startswith('+') and not line.startswith('+++') else ('del' if line.startswith('-') and not line.startswith('---') else '') }}">{{ line }}</span>
{% endfor %}</pre>
    <p class="meta">Trail: {{ fix.trail or fix.trail_error or "not created" }}</p>
    <p class="meta">Trail finding: {{ fix.finding or fix.finding_error or "not created" }}</p>
  </section>

  <section>
    <h2>Guard left behind (neatlogs detection)</h2>
    {% for g in guard.created or [] %}<p class="good">Created <strong>{{ g.name }}</strong> · would have flagged {{ g.preview_count }} recent spans</p>{% endfor %}
    {% for g in guard.existing or [] %}<p>Already watching: {{ g }}</p>{% endfor %}
    {% for g in guard.skipped or [] %}<p class="meta">Skipped {{ g.name }} (preview flagged {{ g.preview_count }})</p>{% endfor %}
    {% for e in guard.errors or [] %}<p class="bad">{{ e }}</p>{% endfor %}
  </section>

  <section>
    <h2>Attempts and recoveries</h2>
    {% if attempts %}<table><tr><th>Attempt</th><th>Fix</th><th>Verify said</th></tr>
      {% for a in attempts %}<tr><td>{{ a.attempt }}</td><td><code>{{ (a.fix or "")[:8] }}</code></td><td>{{ a.verify }}</td></tr>{% endfor %}</table>
    {% else %}<p class="meta">First fix verified.</p>{% endif %}
    <details><summary>{{ errors|length }} recorded errors and retries</summary>
      <table>{% for e in errors %}<tr><td>{{ e.step }}</td><td>{{ e.error }}</td></tr>{% endfor %}</table>
    </details>
  </section>

  <section>
    <h2>Suspects considered</h2>
    <table><tr><th>Commit</th><th>Score</th><th>Reason</th></tr>
      {% for c in candidates %}<tr><td><code>{{ c.sha[:8] }}</code> {{ c.subject }}</td><td>{{ c.score }}</td><td>{{ c.reason }}</td></tr>{% endfor %}</table>
    <p class="meta">Entire graph search: {{ "used" if graph_used else (graph_error or "no result") }} · neatlogs triage second opinion: {{ "matched" if second_opinion else "none" }}</p>
  </section>
</main>
</body>
</html>
